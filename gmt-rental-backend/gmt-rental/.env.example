# Example only: Spring Boot does not load this file automatically.
# Never put a real key in this tracked template.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Gestion Rental <notifications@your-verified-domain.com>"
APP_NAME=Gestion Rental
GMT_SUPPORT_EMAIL=support@your-domain.tld

# PostgreSQL : OBLIGATOIRES hors profil local (le démarrage échoue si elles manquent).
# Ne jamais pointer vers la base réelle depuis un poste de recette.
DATABASE_URL=jdbc:postgresql://localhost:5432/gmt_recette
DATABASE_USERNAME=postgres
# Laisser vide uniquement si le PostgreSQL local est configuré sans mot de passe.
DATABASE_PASSWORD=

# Outside the local profile, set a random JWT key at least 32 bytes long.
GMT_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Durée de la session administrateur en millisecondes (défaut : 8 heures).
GMT_JWT_EXPIRATION_MS=28800000
# Cookie de session : Secure et SameSite=None en production (HTTPS, API et site sur des domaines différents).
GMT_COOKIE_SECURE=true
GMT_COOKIE_SAMESITE=None
# GMT_ADMIN_EMAIL défini => GMT_ADMIN_PASSWORD obligatoire (8 caractères minimum). Compte existant : promu ADMIN.
GMT_ADMIN_EMAIL=
GMT_ADMIN_PASSWORD=

# Site public autorisé à appeler l'API (CORS), séparé par des virgules.
GMT_CORS_ALLOWED_ORIGINS=https://www.your-domain.tld
